  .badge{display:inline-flex;align-items:center;font-size:11px;font-weight:500;padding:2px 8px;border-radius:var(--border-radius-md);margin-right:6px;white-space:nowrap}
  .b-ok{background:#EAF3DE;color:#3B6D11}
  .b-warn{background:#FAEEDA;color:#854F0B}
  .b-red{background:#FCEBEB;color:#A32D2D}
  .b-blue{background:#E6F1FB;color:#185FA5}
